(type Pair (A B)
  (product
    (first A)
    (second B)))

(type CounterPair
  (Pair i32 i64))

(type Identity (T)
  T)

(type CounterId
  (Identity i64))

(fn same-number
  ((params ((value CounterId)))
   (return CounterId)
   (requires ()))
  value)

(fn main
  ((params ())
   (return i64)
   (requires ()))
  (same-number 42))
