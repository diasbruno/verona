(module examples/stdin-random-sum
  (import std/data)

  (extern fn allocate-zeroed
    ((params ((count usize) (size usize)))
     (return Data)
     (requires ()))
    "calloc")
  (extern fn read-stdin
    ((params ((fd i64) (buffer Data) (count usize)))
     (return i64)
     (requires ()))
    "read")
  (extern fn parse-i64
    ((params ((data Data)))
     (return i64)
     (requires ()))
    "atoll")
  (extern fn current-time
    ((params ((timer Data)))
     (return i64)
     (requires ()))
    "time")
  (extern fn process-id
    ((params ())
     (return i64)
     (requires ()))
    "getpid")
  (extern fn seed-random
    ((params ((seed i64)))
     (return unit)
     (requires ()))
    "srandom")
  (extern fn random-i64
    ((params ())
     (return i64)
     (requires ()))
    "random")
  (extern fn put-char
    ((params ((char i64)))
     (return i32)
     (requires ()))
    "putchar")

  (fn digit
    ((params ((value i64)))
     (return i64)
     (requires ()))
    (- value (* (/ value 10) 10)))

  (fn print-positive-i64
    ((params ((value i64)))
     (return unit)
     (requires ()))
    (match (< value 10)
      (true
        (do
          (put-char (+ value 48))
          unit))
      (false
        (do
          (print-positive-i64 (/ value 10))
          (put-char (+ (digit value) 48))
          unit))))

  (fn print-i64
    ((params ((value i64)))
     (return unit)
     (requires ()))
    (match (< value 0)
      (true
        (do
          (put-char 45)
          (print-positive-i64 (- 0 value))
          unit))
      (false
        (print-positive-i64 value))))

  (fn main
    ((params ())
     (return i64)
     (requires ()))
    (let ((buffer (allocate-zeroed 64 1))
          (timer (allocate-zeroed 1 8))
          (read-result (read-stdin 0 buffer 63))
          (input (parse-i64 buffer))
          (seed-result (seed-random (+ (current-time timer) (process-id))))
          (random-number (random-i64))
          (sum (+ input random-number)))
      (print-i64 sum)
      (put-char 10)
      (free timer)
      (free buffer)
      sum)))
