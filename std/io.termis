(module std/io
  (import std/data)
  (import std/string)

  (type IOError
    (sum
      NotFound
      PermissionDenied
      InvalidData
      EndOfFile
      Unknown))

  (type File (& void))

  (extern fn write
    ((params ((data Data)))
     (return i32)
     (requires ())
     (documentation "Write a nul-terminated string followed by a newline."))
    "puts")
  (extern fn print-line
    ((params ((text String)))
     (return i32)
     (requires ())
     (documentation "Print text followed by a newline."))
    "puts"))
