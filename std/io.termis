(module std/io
  (import std/data)

  (type IOError
    (sum
      NotFound
      PermissionDenied
      InvalidData
      EndOfFile
      Unknown))

  (type File (& void))

  (extern fn write
    ((params ((data Data)))
     (return i32)
     (requires ())
     (documentation "Write a nul-terminated string followed by a newline."))
    "puts"))
