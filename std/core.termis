(module std/core
  (class Integer (T))

  (provide core/math
    (fn +
      ((type-params (T))
       (params ((left T) (right T)))
       (return T)
       (requires ((Integer T)))
       (documentation "Add two integers.")))
    (fn -
      ((type-params (T))
       (params ((left T) (right T)))
       (return T)
       (requires ((Integer T)))
       (documentation "Subtract two integers.")))
    (fn *
      ((type-params (T))
       (params ((left T) (right T)))
       (return T)
       (requires ((Integer T)))
       (documentation "Multiply two integers.")))
    (fn /
      ((type-params (T))
       (params ((left T) (right T)))
       (return T)
       (requires ((Integer T)))
       (documentation "Divide two integers."))))

  (provide core/comparison
    (fn =
      ((type-params (T))
       (params ((left T) (right T)))
       (return bool)
       (requires ((Integer T)))
       (documentation "Return true when two integers are equal.")))
    (fn !=
      ((type-params (T))
       (params ((left T) (right T)))
       (return bool)
       (requires ((Integer T)))
       (documentation "Return true when two integers are different.")))
    (fn <
      ((type-params (T))
       (params ((left T) (right T)))
       (return bool)
       (requires ((Integer T)))
       (documentation "Return true when the left integer is smaller.")))
    (fn <=
      ((type-params (T))
       (params ((left T) (right T)))
       (return bool)
       (requires ((Integer T)))
       (documentation "Return true when the left integer is smaller or equal.")))
    (fn >
      ((type-params (T))
       (params ((left T) (right T)))
       (return bool)
       (requires ((Integer T)))
       (documentation "Return true when the left integer is greater.")))
    (fn >=
      ((type-params (T))
       (params ((left T) (right T)))
       (return bool)
       (requires ((Integer T)))
       (documentation "Return true when the left integer is greater or equal.")))))
