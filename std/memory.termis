(module std/memory
  (import std/data)

  (extern fn allocate
    ((params ((size usize)))
     (return Data)
     (requires ())
     (documentation "Allocate raw storage."))
    "malloc")
  (extern fn reallocate
    ((params ((data Data) (size usize)))
     (return Data)
     (requires ())
     (documentation "Resize raw storage."))
    "realloc")
  (extern fn free
    ((params ((data Data)))
     (return unit)
     (requires ())
     (documentation "Release raw storage."))
    "free")

  (extern fn copy
    ((params ((destination Data) (source Data) (size usize)))
     (return Data)
     (requires ())
     (documentation "Copy raw storage."))
    "memcpy")
  (extern fn move
    ((params ((destination Data) (source Data) (size usize)))
     (return Data)
     (requires ())
     (documentation "Move possibly-overlapping raw storage."))
    "memmove")
  (extern fn set
    ((params ((data Data) (value u8) (size usize)))
     (return Data)
     (requires ())
     (documentation "Fill raw storage with a byte value."))
    "memset")
  (extern fn compare
    ((params ((left Data) (right Data) (size usize)))
     (return i32)
     (requires ())
     (documentation "Compare raw storage."))
    "memcmp")

  (extern fn length-until-zero
    ((params ((data Data)))
     (return usize)
     (requires ())
     (documentation "Count bytes before the first zero byte."))
    "strlen")
  (extern fn copy-until-zero
    ((params ((destination Data) (source Data)))
     (return Data)
     (requires ())
     (documentation "Copy bytes through the first zero byte."))
    "strcpy")
  (extern fn copy-until-zero-size
    ((params ((destination Data) (source Data) (size usize)))
     (return Data)
     (requires ())
     (documentation "Copy at most size bytes from zero-terminated storage."))
    "strncpy")
  (extern fn concatenate-until-zero
    ((params ((destination Data) (source Data)))
     (return Data)
     (requires ())
     (documentation "Append bytes from zero-terminated storage."))
    "strcat")
  (extern fn concatenate-until-zero-size
    ((params ((destination Data) (source Data) (size usize)))
     (return Data)
     (requires ())
     (documentation "Append at most size bytes from zero-terminated storage."))
    "strncat")
  (extern fn compare-until-zero
    ((params ((left Data) (right Data)))
     (return i32)
     (requires ())
     (documentation "Compare zero-terminated storage."))
    "strcmp")
  (extern fn compare-until-zero-size
    ((params ((left Data) (right Data) (size usize)))
     (return i32)
     (requires ())
     (documentation "Compare at most size bytes of zero-terminated storage."))
    "strncmp")
  (extern fn find-byte-until-zero
    ((params ((data Data) (value i32)))
     (return Data)
     (requires ())
     (documentation "Find a byte before the first zero byte."))
    "strchr"))
